APP_NAME="Secretlab KV Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://secretlab.kreio.tech

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=info

# PostgreSQL runs natively on the VPS host, outside Docker.
# Locally (compose.dev.yml) use DB_HOST=postgres instead.
DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=kvstore
DB_USERNAME=kvstore
DB_PASSWORD=

# Redis backs both the cache and the rate limiter. Laravel's file driver has no
# atomic increment, so its counters undercount under concurrent load.
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# No sessions and no queued jobs in this service, so neither needs a table.
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Operational knobs. See config/kv.php for the values that never change.
KV_CACHE_TTL=60
KV_RATE_LIMIT_ANONYMOUS=120
KV_RATE_LIMIT_CLIENT=600
