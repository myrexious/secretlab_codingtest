<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>

        <!--
            Tests run against real PostgreSQL, never SQLite. SQLite has no
            clock_timestamp() and different json semantics, so a SQLite suite
            would pass while production breaks.
            DB_HOST comes from the environment: "postgres" locally, whatever
            the CI service container is called in GitHub Actions.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="kvstore_test"/>

        <!--
            Real Redis too. The cache bypass and the rate limiter are features
            under test, so an array driver would not exercise them.
            Database 15 keeps the suite off the development cache.
        -->
        <env name="CACHE_STORE" value="redis"/>
        <env name="REDIS_CACHE_DB" value="15"/>

        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
